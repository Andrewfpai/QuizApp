rules_version = '2';

// Recall sync rules. Paste into Firebase console → Firestore Database → Rules → Publish.
// Every quiz and attempt is one document at users/{uid}/items/{id}. Deleted ones stay as
// tombstones (deleted = true) so the delete reaches your other devices.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/items/{id} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function isValid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['kind', 'data', 'updatedAt', 'deleted', 'syncedAt'])
          && d.kind in ['quiz', 'attempt']
          && (d.data == null || d.data is string)
          && d.updatedAt is int
          && d.deleted is bool
          && d.syncedAt == request.time; // devices pull by this server time
      }

      allow read: if isOwner();
      allow create: if isOwner() && isValid();
      // Only a newer version may replace a stored one, so an old offline edit can't clobber a newer change.
      allow update: if isOwner() && isValid() && request.resource.data.updatedAt > resource.data.updatedAt;
      allow delete: if false;
    }
  }
}
